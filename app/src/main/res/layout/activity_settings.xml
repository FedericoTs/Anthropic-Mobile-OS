<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/settings_title"
            android:textColor="@color/text"
            android:textSize="26sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:text="@string/settings_explainer"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <!-- Planner model picker (populated from ModelCatalog at runtime) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="@string/settings_model_header"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp"
            android:text="@string/settings_model_explainer"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/model_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:orientation="vertical" />

        <!-- API key (the default, supported path) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="@string/settings_apikey_header"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:hint="@string/settings_key_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:minHeight="56dp"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/accent"
            android:text="@string/settings_save"
            android:textColor="@color/on_accent"
            tools:ignore="ButtonStyle" />

        <!-- Claude subscription login (bring-your-own token) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="28dp"
            android:paddingBottom="6dp"
            android:text="@string/settings_token_header"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp"
            android:text="@string/settings_token_explainer"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/input_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:hint="@string/settings_token_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:minHeight="56dp"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_save_login"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/accent"
            android:text="@string/settings_save_login"
            android:textColor="@color/on_accent"
            tools:ignore="ButtonStyle" />

        <Button
            android:id="@+id/btn_clear"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="20dp"
            android:text="@string/settings_clear"
            android:textAllCaps="false"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
