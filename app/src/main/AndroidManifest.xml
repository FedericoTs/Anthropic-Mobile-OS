<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The planner talks to the Anthropic Messages API over HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Direct capabilities: set_timer / set_alarm fire the clock app's intents. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- See installed launcher apps for the app-grid escape hatch, and probe which
         fast-path capabilities this device can actually handle (Android 11+ package
         visibility requires declaring every intent we resolveActivity() against). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:scheme="content" android:host="com.android.calendar" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgentOS"
        tools:ignore="DataExtractionRules">

        <!-- T5: the static ambient home (idle resting face). -->
        <activity
            android:name=".ui.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The trust surface: the live narration feed. -->
        <activity
            android:name=".ui.NarrationActivity"
            android:exported="false" />

        <!-- Escape hatch: the classic app grid. -->
        <activity
            android:name=".ui.AppGridActivity"
            android:exported="false" />

        <!-- Model credential entry. -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <!-- The agent: perceives + acts on the live screen and runs the loop. -->
        <service
            android:name=".device.AgentAccessibilityService"
            android:exported="false"
            android:label="@string/agent_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/agent_accessibility_config" />
        </service>

        <!-- adb/demo-driven entry point (run an intent, or a scripted plan for CI).
             exported so the shell UID can reach it; demo/emulator only. -->
        <receiver
            android:name=".device.AgentCommandReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver" />
    </application>
</manifest>
